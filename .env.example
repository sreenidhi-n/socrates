# SOCrates Environment Configuration
# Copy to .env and fill in your values

# === AMD Developer Cloud — Droplet Config ===
AMD_API_URL=http://api.devcloud.amd.com/
AMD_DROPLET_IMAGE=rocm-7-2-software
AMD_DROPLET_SIZE=gpu-mi300x8-1536gb-devcloud
AMD_DROPLET_REGION=atl1

# === vLLM Endpoints (auto-filled by create_droplet.sh after IP is assigned) ===
LLAMA_BASE_URL=http://<your-droplet-ip>:8000/v1
QWEN_BASE_URL=http://<your-droplet-ip>:8090/v1
VLLM_API_KEY=your-vllm-api-key-here

# === Model Names (must match --served-model-name in vLLM) ===
LLAMA_MODEL_NAME=llama
QWEN_MODEL_NAME=qwen

# === NVD API (optional — higher rate limits with key) ===
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# === Hugging Face (for model downloads on AMD cloud) ===
HF_TOKEN=your-hf-token-here
